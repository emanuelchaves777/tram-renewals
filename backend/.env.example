# TRAM Renewals Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# ── Box API ───────────────────────────────────────────────────────────────────
# Get these from developer.box.com → Your App → Configuration
BOX_CLIENT_ID=your_box_client_id_here
BOX_CLIENT_SECRET=your_box_client_secret_here

# The numeric folder ID from your Box URL
# e.g. https://ibm.ent.box.com/folder/123456789  →  BOX_FOLDER_ID=123456789
BOX_FOLDER_ID=your_box_folder_id_here

# Developer token for local testing (expires every 60 min — Box dev console)
# Leave blank in production; use OAuth flow instead
BOX_DEV_TOKEN=

# ── Taxonomy File ─────────────────────────────────────────────────────────────
# Numeric Box file ID for the JRS taxonomy .xlsx
# Get it from the Box URL when you open the file: /file/XXXXXXXXXX
BOX_TAXONOMY_FILE_ID=your_taxonomy_file_id_here

# ── App Settings ──────────────────────────────────────────────────────────────
# How many days old a report can be before showing a staleness warning
STALENESS_WARNING_DAYS=3

# Secret key for signing session tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=change_this_to_a_random_secret

# Allowed origins for CORS (your GitHub Pages URL)
CORS_ORIGIN=https://emanuelchaves777.github.io
